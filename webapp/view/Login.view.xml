<mvc:View
    controllerName="salesordertracking.zsotracking.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        showHeader="false"
        class="loginPage"
    >
        <content>
            <VBox
                width="100%"
                height="100%"
                alignItems="Center"
                justifyContent="Center"
            >
                <VBox
                    width="380px"
                    class="sapUiMediumMargin sapUiResponsiveMargin"
                >
                    <VBox
                        alignItems="Center"
                        class="sapUiMediumMarginBottom"
                    >
                        <core:Icon
                            src="sap-icon://sales-order"
                            size="4rem"
                            class="sapUiMediumMarginBottom"
                        />

                        <Title
                            text="Sales Order Tracking"
                            level="H1"
                        />

                        <Text
                            text="Sales Management Portal"
                            class="sapUiSmallMarginTop"
                        />
                    </VBox>

                    <Panel
                        headerText="Login"
                        width="100%"
                        class="sapUiResponsiveMargin"
                    >
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <Label
                                    text="User Name"
                                    required="true"
                                />

                                <Input
                                    id="username"
                                    placeholder="Enter user name"
                                    width="100%"
                                    class="sapUiSmallMarginBottom"
                                />

                                <Label
                                    text="Password"
                                    required="true"
                                />

                                <Input
                                    id="password"
                                    type="Password"
                                    placeholder="Enter password"
                                    width="100%"
                                    class="sapUiSmallMarginBottom"
                                />

                                <Button
                                    text="Login"
                                    type="Emphasized"
                                    icon="sap-icon://log"
                                    width="100%"
                                    press=".onLogin"
                                    class="sapUiSmallMarginBottom"
                                />

                                <Link
                                    text="Don't have an account? Sign Up"
                                    press=".onOpenRegisterDialog"
                                    textAlign="Center"
                                    width="100%"
                                />
                            </VBox>
                        </content>
                    </Panel>

                    <Text
                        text="Sales Order Tracking • Training Application"
                        textAlign="Center"
                        width="100%"
                        class="sapUiSmallMarginTop"
                    />
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>

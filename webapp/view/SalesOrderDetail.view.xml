<mvc:View
    controllerName="salesordertracking.zsotracking.controller.SalesOrderDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <uxap:ObjectPageLayout
        id="ObjectPageLayout"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="true"
        useIconTabBar="true"
        showAnchorBar="true"
        upperCaseAnchorBar="false"
    >
        <!-- Header Title -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title
                        text="Sales Order: {SoId}"
                        level="H2"
                        wrapping="true"
                    />
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title
                        text="Sales Order: {SoId}"
                        level="H2"
                        wrapping="true"
                    />
                </uxap:snappedHeading>

                <uxap:actions>
                    <Button
                        text="View Items"
                        icon="sap-icon://detail-view"
                        press="onNavToItemsFromDetail"
                    />
                    <Button
                        text="Edit"
                        type="Emphasized"
                        icon="sap-icon://edit"
                        press="onEditOrder"
                    />
                    <Button
                        text="Delete"
                        type="Reject"
                        icon="sap-icon://delete"
                        press="onDeleteOrder"
                    />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <!-- Header Content -->
        <uxap:headerContent>
            <layout:HorizontalLayout allowWrapping="true">
                <layout:VerticalLayout
                    class="sapUiMediumMarginEnd sapUiTinyMarginBottom"
                >
                    <Label
                        text="Status"
                        class="sapUiTinyMarginBottom"
                    />
                    <ObjectStatus
                        text="{Status}"
                        state="{path: 'Status', formatter: '.formatStatusState'}"
                        class="sapMObjectStatusLarge"
                    />
                </layout:VerticalLayout>

                <layout:VerticalLayout
                    class="sapUiMediumMarginEnd sapUiTinyMarginBottom"
                >
                    <Label
                        text="Customer Name"
                        class="sapUiTinyMarginBottom"
                    />
                    <Text
                        text="{CustomerName}"
                        class="sapUiSelectable"
                    />
                </layout:VerticalLayout>

                <layout:VerticalLayout
                    class="sapUiMediumMarginEnd sapUiTinyMarginBottom"
                >
                    <Label
                        text="Total Amount"
                        class="sapUiTinyMarginBottom"
                    />
                    <ObjectNumber
                        number="{path: 'TotalAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 }}"
                        unit="{Currency}"
                    />
                </layout:VerticalLayout>
            </layout:HorizontalLayout>
        </uxap:headerContent>

        <!-- Page Sections -->
        <uxap:sections>
            <uxap:ObjectPageSection title="General Information">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection title="Order Summary">
                        <uxap:blocks>
                            <form:SimpleForm
                                editable="false"
                                layout="ColumnLayout"
                                columnsM="2"
                                columnsL="3"
                                columnsXL="3"
                            >
                                <form:content>
                                    <core:Title
                                        text="Sales Order Information"
                                    />

                                    <Label text="Sales Order ID" />
                                    <Text
                                        text="{SoId}"
                                        class="sapUiSmallMarginBottom"
                                    />

                                    <Label text="Customer ID" />
                                    <Text
                                        text="{CustomerId}"
                                        class="sapUiSmallMarginBottom"
                                    />

                                    <Label text="Customer Name" />
                                    <Text
                                        text="{CustomerName}"
                                        class="sapUiSmallMarginBottom"
                                    />

                                    <core:Title text="Order Details" />

                                    <Label text="Order Date" />
                                    <Text
                                        text="{
                                path: 'OrderDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: {
                                    style: 'medium'
                                }
                            }"
                                    />

                                    <Label text="Status" />
                                    <ObjectStatus
                                        text="{Status}"
                                        state="{path: 'Status', formatter: '.formatStatusState'}"
                                    />

                                    <Label text="Currency" />
                                    <Text text="{Currency}" />

                                    <Label text="Total Amount" />
                                    <ObjectNumber
                                        number="{
                                path: 'TotalAmount',
                                type: 'sap.ui.model.type.Float',
                                formatOptions: {
                                    minFractionDigits: 2,
                                    maxFractionDigits: 2
                                }
                            }"
                                        unit="{Currency}"
                                    />
                                </form:content>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Section 2: Independent Line Items CRUD -->
            <uxap:ObjectPageSection title="Line Items">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table
                                id="itemsTable"
                                items="{/SalesOrderItemSet}"
                                growing="true"
                                growingThreshold="10"
                                updateFinished="onTableUpdateFinished"
                                sticky="HeaderToolbar,ColumnHeaders"
                                inset="false"
                            >
                                <headerToolbar>
                                    <OverflowToolbar style="Clear">
                                        <Title
                                            id="tableTitle"
                                            text="Items"
                                            level="H3"
                                        />
                                        <ToolbarSpacer />
                                        <Button
                                            icon="sap-icon://add"
                                            text="Add Item"
                                            type="Emphasized"
                                            press="onAddItem"
                                        />
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column width="10%">
                                        <Text text="Sales Order ID" />
                                    </Column>
                                    <Column
                                        width="8%"
                                        hAlign="Center"
                                    >
                                        <Text text="Item No" />
                                    </Column>
                                    <Column width="18%">
                                        <Text text="Material" />
                                    </Column>
                                    <Column width="26%">
                                        <Text text="Description" />
                                    </Column>
                                    <Column
                                        width="10%"
                                        hAlign="End"
                                    >
                                        <Text text="Quantity" />
                                    </Column>
                                    <Column
                                        width="12%"
                                        hAlign="End"
                                    >
                                        <Text text="Unit Price" />
                                    </Column>
                                    <Column
                                        width="12%"
                                        hAlign="End"
                                    >
                                        <Text text="Net Value" />
                                    </Column>
                                    <Column
                                        width="4rem"
                                        hAlign="Center"
                                    >
                                        <Text text="Actions" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <Text text="{SoId}" />
                                            <Text text="{ItemNo}" />
                                            <Text text="{Material}" />
                                            <Text text="{Description}" />
                                            <ObjectNumber
                                                number="{path: 'Quantity', type: 'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 3 }}"
                                            />
                                            <ObjectNumber
                                                number="{path: 'UnitPrice', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 }}"
                                                unit="{Currency}"
                                            />
                                            <ObjectNumber
                                                number="{
                                                    parts: [{path: 'Quantity'}, {path: 'UnitPrice'}],
                                                    formatter: '.calculateItemTotal'
                                                }"
                                                unit="{Currency}"
                                            />
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete Item"
                                                press="onDeleteItem"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>

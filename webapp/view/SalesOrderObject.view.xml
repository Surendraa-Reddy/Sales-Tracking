<mvc:View
    controllerName="salesordertracking.zsotracking.controller.SalesOrderObject"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page
        id="salesOrderObjectPage"
        title="Sales Order Details"
        showNavButton="true"
        navButtonPress=".onNavBack"
        backgroundDesign="List"
    >
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- HEADER DETAILS -->
                <ObjectHeader
                    title="Order {SoId}"
                    number="{
                        path: 'TotalAmount',
                        formatter: '.formatAmount'
                    }"
                    numberUnit="{Currency}"
                    intro="Sales Order Overview"
                    class="sapUiSmallMarginBottom"
                >
                    <attributes>
                        <ObjectAttribute text="Customer Name: {CustomerName}" />
                        <ObjectAttribute text="Customer ID: {CustomerId}" />
                        <ObjectAttribute
                            text="Order Date: {
                            path: 'OrderDate',
                            formatter: '.formatOrderDate'
                        }"
                        />
                    </attributes>
                    <statuses>
                        <ObjectStatus
                            text="{Status}"
                            state="{
                                path: 'Status',
                                formatter: '.formatStatusState'
                            }"
                            inverted="true"
                        />
                    </statuses>
                </ObjectHeader>

              
                <Table
                    id="orderItemsTable"
                    headerText="Line Items"
                    items="{/SalesOrderItemSet}"
                >
                    <columns>
                        <Column
                            width="5rem"
                            hAlign="Center"
                        >
                            <Text text="Item No" />
                        </Column>
                        <Column
                            demandPopin="true"
                            minScreenWidth="Tablet"
                        >
                            <Text text="Material &amp; Description" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="Quantity" />
                        </Column>
                        <Column
                            hAlign="End"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                        >
                            <Text text="Unit Price" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="Total Price" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{ItemNo}" />
                                <ObjectIdentifier
                                    title="{Description}"
                                    text="{Material}"
                                />
                                <Text
                                    text="{path: 'Quantity', formatter: '.formatQuantity'}"
                                />
                                <ObjectNumber
                                    number="{path: 'UnitPrice', formatter: '.formatAmount'}"
                                    unit="{Currency}"
                                />
                                <ObjectNumber
                                    number="{parts: [{path: 'Quantity'}, {path: 'UnitPrice'}], formatter: '.calculateLineTotal'}"
                                    unit="{Currency}"
                                    emphasized="true"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>

<mvc:View
    controllerName="salesordertracking.zsotracking.controller.SalesDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <Page
        id="salesDashboardPage"
        title="Sales Dashboard"
        backgroundDesign="Solid"
        showHeader="true"
    >
        <headerContent>
            <Text
                text="{dashboard>/LastRefreshText}"
                class="sapUiSmallMarginEnd"
            />
            <Button
                icon="sap-icon://refresh"
                tooltip="Refresh Dashboard"
                type="Transparent"
                press=".onRefresh"
            />
            <Button
                icon="sap-icon://log"
                text="Logout"
                type="Transparent"
                press=".onLogout"
            />
        </headerContent>

        <content>
            <VBox
                class="sapUiResponsiveMargin"
                width="auto"
            >
                <VBox class="sapUiMediumMarginBottom">
                    <Title
                        text="Sales Order Overview"
                        level="H1"
                    />
                    <Text
                        text="Monitor sales orders, order status and sales performance."
                        class="sapUiTinyMarginTop"
                    />
                </VBox>

                
                <f:GridList
                    headerText="Key Performance Indicators"
                    class="sapUiSmallMarginBottom"
                >
                    <f:customLayout>
                        <cssgrid:GridBoxLayout boxWidth="17rem" />
                    </f:customLayout>

                    <f:items>
                       
                        <CustomListItem
                            type="Active"
                            press=".onTotalOrdersPress"
                        >
                            <VBox class="sapUiSmallMargin">
                                <HBox
                                    justifyContent="SpaceBetween"
                                    alignItems="Center"
                                >
                                    <Text
                                        text="Total Orders"
                                        class="sapUiTinyMarginBottom"
                                    />
                                    <core:Icon src="sap-icon://sales-order" />
                                </HBox>
                                <ObjectNumber
                                    number="{dashboard>/TotalOrders}"
                                    emphasized="true"
                                />
                                <Text
                                    text="All sales orders"
                                    class="sapUiTinyMarginTop"
                                />
                            </VBox>
                        </CustomListItem>

                       
                        <CustomListItem
                            type="Active"
                            press=".onOpenOrdersPress"
                        >
                            <VBox class="sapUiSmallMargin">
                                <HBox
                                    justifyContent="SpaceBetween"
                                    alignItems="Center"
                                >
                                    <Text text="Open Orders" />
                                    <core:Icon src="sap-icon://pending" />
                                </HBox>
                                <ObjectNumber
                                    number="{dashboard>/OpenOrders}"
                                    state="Warning"
                                    emphasized="true"
                                />
                                <Text
                                    text="Awaiting processing"
                                    class="sapUiTinyMarginTop"
                                />
                            </VBox>
                        </CustomListItem>

                       
                        <CustomListItem
                            type="Active"
                            press=".onInProcessPress"
                        >
                            <VBox class="sapUiSmallMargin">
                                <HBox
                                    justifyContent="SpaceBetween"
                                    alignItems="Center"
                                >
                                    <Text text="In Process" />
                                    <core:Icon src="sap-icon://process" />
                                </HBox>
                                <ObjectNumber
                                    number="{dashboard>/InProcessOrders}"
                                    state="Information"
                                    emphasized="true"
                                />
                                <Text
                                    text="Currently processing"
                                    class="sapUiTinyMarginTop"
                                />
                            </VBox>
                        </CustomListItem>

                      
                        <CustomListItem
                            type="Active"
                            press=".onDeliveredPress"
                        >
                            <VBox class="sapUiSmallMargin">
                                <HBox
                                    justifyContent="SpaceBetween"
                                    alignItems="Center"
                                >
                                    <Text text="Delivered" />
                                    <core:Icon
                                        src="sap-icon://shipping-status"
                                    />
                                </HBox>
                                <ObjectNumber
                                    number="{dashboard>/DeliveredOrders}"
                                    state="Success"
                                    emphasized="true"
                                />
                                <Text
                                    text="Completed orders"
                                    class="sapUiTinyMarginTop"
                                />
                            </VBox>
                        </CustomListItem>
                    </f:items>
                </f:GridList>

        
                <l:Grid
                    defaultSpan="L6 M6 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapUiNoContentPadding sapUiSmallMarginBottom"
                >
                    
                    <Panel
                        headerText="Order Status"
                        class="sapUiNoContentPadding"
                    >
                        <content>
                            <VBox class="sapUiSmallMargin">
                                <viz:VizFrame
                                    id="statusChart"
                                    vizType="donut"
                                    width="100%"
                                    height="300px"
                                    uiConfig="{applicationSet:'fiori'}"
                                    vizProperties="{
                                        plotArea: {
                                            dataLabel: { visible: true }
                                        },
                                        legend: { visible: true },
                                        title: { visible: false }
                                    }"
                                >
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset
                                            data="{dashboard>/StatusData}"
                                        >
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition
                                                    name="Status"
                                                    value="{dashboard>Status}"
                                                />
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition
                                                    name="Orders"
                                                    value="{dashboard>Count}"
                                                />
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem
                                            uid="color"
                                            type="Dimension"
                                            values="Status"
                                        />
                                        <viz.feeds:FeedItem
                                            uid="size"
                                            type="Measure"
                                            values="Orders"
                                        />
                                    </viz:feeds>
                                </viz:VizFrame>
                            </VBox>
                        </content>
                    </Panel>

                  
                    <Panel
                        headerText="Sales Summary"
                        class="sapUiNoContentPadding"
                    >
                        <content>
                            <VBox class="sapUiMediumMargin">
                                <HBox
                                    justifyContent="SpaceBetween"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Text text="Total Sales" />
                                    <ObjectNumber
                                        number="{dashboard>/TotalSales}"
                                        unit="{dashboard>/Currency}"
                                        emphasized="true"
                                    />
                                </HBox>

                                <HBox
                                    justifyContent="SpaceBetween"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Text text="Average Order Value" />
                                    <ObjectNumber
                                        number="{dashboard>/AverageOrderValue}"
                                        unit="{dashboard>/Currency}"
                                    />
                                </HBox>

                                <HBox justifyContent="SpaceBetween">
                                    <Text text="Total Line Items" />
                                    <ObjectNumber
                                        number="{dashboard>/TotalItems}"
                                    />
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>
                </l:Grid>

               
                <Panel
                    headerText="Recent Sales Orders"
                    class="sapUiSmallMarginBottom"
                >
                    <content>
                        <Table
                            id="recentOrdersTable"
                            items="{dashboard>/RecentOrders}"
                            noDataText="No sales orders available"
                            growing="true"
                            growingThreshold="5"
                        >
                            <columns>
                                <Column>
                                    <Text text="Sales Order" />
                                </Column>
                                <Column>
                                    <Text text="Customer" />
                                </Column>
                                <Column>
                                    <Text text="Order Date" />
                                </Column>
                                <Column>
                                    <Text text="Status" />
                                </Column>
                                <Column hAlign="End">
                                    <Text text="Total Amount" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem
                                    type="Active"
                                    press=".onRecentOrderPress"
                                >
                                    <cells>
                                        <ObjectIdentifier
                                            title="{dashboard>SoId}"
                                        />
                                        <Text text="{dashboard>CustomerName}" />
                                        <Text text="{dashboard>OrderDate}" />
                                        <ObjectStatus
                                            text="{dashboard>Status}"
                                            state="{dashboard>StatusState}"
                                        />
                                        <ObjectNumber
                                            number="{dashboard>TotalAmount}"
                                            unit="{dashboard>Currency}"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

                <!-- QUICK ACTIONS
                <Panel
                    headerText="Quick Actions"
                    class="sapUiSmallMarginBottom"
                >
                    <content>
                        <HBox
                            wrap="Wrap"
                            class="sapUiSmallMargin"
                        >
                            <Button
                                text="View Sales Orders"
                                icon="sap-icon://list"
                                type="Emphasized"
                                press=".onViewOrders"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            />
                            <Button
                                text="Refresh Dashboard"
                                icon="sap-icon://refresh"
                                press=".onRefresh"
                                class="sapUiSmallMarginBottom"
                            />
                        </HBox>
                    </content>
                </Panel> -->
            </VBox>
        </content>
    </Page>
</mvc:View>
